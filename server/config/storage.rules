rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function registered(uid) {
   return request.auth != null &&
     request.auth.uid == uid &&
     request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function isImage() {
   return request.resource.contentType.matches('image/(jpeg|png|webp)') &&
    request.resource.size <= 5 * 1024 * 1024;
  }
  match /postUploads/{uid}/{draftId}/{name} {
   allow read: if true;
   allow create: if registered(uid) &&
     draftId.matches('[A-Za-z0-9_-]{8,90}') &&
     name.matches('media\\.(jpg|png|webp|mp4)') &&
     (isImage() || (request.resource.contentType == 'video/mp4' && request.resource.size <= 25 * 1024 * 1024));
   allow update, delete: if false;
  }
  match /avatars/{uid}/{filename} {
   allow read: if true;
   allow create: if registered(uid) && filename.matches('[A-Za-z0-9_-]{8,90}\\.(jpg|png|webp)') && isImage();
   allow update, delete: if false;
  }
  match /{all=**} { allow read, write: if false; }
 }
}
