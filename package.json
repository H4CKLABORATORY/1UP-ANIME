{
  "name": "oneup-anime",
  "version": "2.0.0",
  "private": true,
  "description": "1UP Anime — Catálogo editorial, reproductor PWA mobile-first y motor cinematográfico Dexter",
  "scripts": {
    "build": "vite build",
    "dev:vite": "vite",
    "preview": "vite preview",
    "start": "node scripts/serve-client.mjs 8765",
    "dev": "node scripts/serve-client.mjs 8765",
    "serve": "node scripts/serve-client.mjs 8765",
    "serve:catalog": "node server/src/catalog-service.js 4050",
    "catalog:api": "node server/src/catalog-service.js 4050",
    "test": "node --test tests/unit/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:python": "python -m unittest discover tests",
    "test:ui": "node scripts/check-ui.mjs",
    "test:guard": "node scripts/oneup-guard.mjs --offline",
    "test:all": "node --test tests/unit/*.test.mjs && python -m unittest discover tests && node scripts/check-ui.mjs && node scripts/oneup-guard.mjs --offline",
    "test:depth": "playwright test tests/e2e/depth-mode.spec.js",
    "test:puppeteer": "node scripts/puppeteer-site-audit.mjs",
    "test:motion-engine": "node --test tests/unit/dexter-motion-engine.test.mjs",
    "test:motion-studio": "node --test tests/unit/motion-studio.test.mjs tests/unit/motion-studio-camera.test.mjs",
    "render:motion-studio": "node scripts/render-motion-studio.mjs",
    "sync:dexter": "node scripts/dexter-anime-sync.mjs",
    "refresh:catalog": "node scripts/refresh-catalog.mjs",
    "refresh:airing": "node scripts/refresh-airing.mjs",
    "handoff": "node scripts/update-new-chat-handoff.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "puppeteer": "25.14.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  }
}
