# 1UP Anime — Supabase config (PUBLIC values, reference only)
# These are the values Douglas copies from Supabase (Project Settings > API)
# into supabase-config.js. The site is static (GitHub Pages): it reads
# supabase-config.js, not this file.
# Never put a service_role key (sb_secret_...), the database password,
# or any personal access token here.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_PUBLICA
SUPABASE_PROJECT_REF=tu-project-ref
