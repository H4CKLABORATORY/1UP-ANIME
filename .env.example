# 1UP Anime — Firebase web config (PUBLIC values, reference only)
# These are the values Douglas copies from Firebase console
# (Project settings > Your apps > Web) into auth-config.js.
# The site is static (GitHub Pages): it reads auth-config.js, not this file.
# Never put a service-account JSON or any private key here.
FIREBASE_API_KEY=AIza...
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef...
